# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App Base Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dodo Payments Configuration (Ride Sathi API Key)
# Secure backend environment variable - NEVER expose in client side code
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here
API_KEY=your_dodo_payments_api_key_here
DODO_PAYMENTS_ENV=live_mode
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_payments_webhook_secret_here

# Analytics & Tracking Configuration
# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_microsoft_clarity_project_id_here
